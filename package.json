{
  "name": "llm-router-axi",
  "version": "0.1.0",
  "description": "AXI: policy-driven LLM router that turns a task descriptor plus live usage into one harness/model/effort decision with fallback chain and spawn flags",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/adibirzu/llm-router-axi.git"
  },
  "keywords": [
    "llm",
    "router",
    "routing",
    "dispatch",
    "agent",
    "axi",
    "toon",
    "policy"
  ],
  "bin": {
    "llm-router-axi": "./dist/bin/llm-router-axi.js"
  },
  "files": [
    "dist",
    "skills/llm-router-axi",
    "policy.schema.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "build:skill": "tsx scripts/build-skill.ts",
    "build:policy-schema": "tsx scripts/build-policy-schema.ts",
    "dev": "tsx bin/llm-router-axi.ts",
    "lint": "eslint bin src test scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@toon-format/toon": "^2.1.0",
    "ajv": "^8.17.1",
    "axi-sdk-js": "^0.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
