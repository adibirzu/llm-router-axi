{
  "$schema": "https://raw.githubusercontent.com/adibirzu/llm-router-axi/main/policy.schema.json",
  "version": 1,
  "routing": {
    "reservePercent": 20,
    "cooldownSeconds": 1800,
    "telemetryMaxAgeSeconds": 300,
    "maxFallbacks": 4
  },
  "capacity": {
    "agentCeiling": 15,
    "oneSuiteAtATime": true,
    "memoryFreeReservePercent": 10,
    "maxLoadPerCore": 2,
    "memoryPressureMax": "warn",
    "maxSwapUsedPercent": null,
    "llamaParallel": 2
  },
  "pools": {
    "cursor": {
      "default": "auto_usage",
      "auto": "auto_usage",
      "api": "api_usage"
    },
    "agy": {
      "default": "gemini",
      "gemini": [
        "gemini_5h",
        "gemini_weekly"
      ],
      "nonGemini": [
        "claude_gpt_5h",
        "claude_gpt_weekly"
      ]
    },
    "opencode": {
      "default": "opencode-go",
      "go": "opencode-go",
      "free": "opencode"
    }
  },
  "spendPriority": {
    "weight": 1,
    "tieBreaker": "least-recent-use",
    "preferKnown": true
  },
